# Hexagonal RAG Agent Configuration Template

# Toggle mock mode (set to False to connect to real Azure resources)
MOCK_MODE=False

# Local developer testing (optional, used in mock mode if not using simulated responses)
OPENAI_API_KEY=mock-key

# Azure AI Foundry Configuration
AZURE_AI_FOUNDRY_ENDPOINT=https://xxxxx.services.ai.azure.com
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini-demo

# Azure AI Search Index Configuration
AZURE_SEARCH_ENDPOINT=https://xxxxx.search.windows.net
AZURE_SEARCH_INDEX_NAME=index-name
AZURE_SEARCH_API_KEY=xxxxxx
AZURE_SEARCH_MODE=semantic
AZURE_SEARCH_TOP_K=5
# AZURE_SEARCH_VECTOR_FIELD=content_vector
AZURE_SEARCH_SEMANTIC_CONFIG=default-semantic-config

# Session Persistence Settings (options: memory, cosmos, redis)
SESSION_STORE_TYPE=memory

# Cosmos DB Configuration (used if SESSION_STORE_TYPE=cosmos)
COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-key
COSMOS_DATABASE_NAME=rag-agent-db
COSMOS_CONTAINER_NAME=sessions

# Redis Configuration (used if SESSION_STORE_TYPE=redis)
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=86400

# Memory Compaction / Optimization Settings
MEMORY_COMPACTION_ENABLED=false
MEMORY_COMPACTION_STRATEGY=summarization
MEMORY_COMPACTION_TARGET_COUNT=4
MEMORY_COMPACTION_THRESHOLD=2

